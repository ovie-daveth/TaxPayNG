# SMTP Configuration for Email Sending
# Copy these to your .env.local file (or .env file)

# Required SMTP Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=omokefeovie1@gmail.com
SMTP_PASS=your_app_password_here

# Optional: Custom "From" address
SMTP_FROM=noreply@otax.com

# Optional: App URL for email links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# IMPORTANT: For Gmail, you MUST use an App Password
# ============================================
# 
# Steps to get Gmail App Password:
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification (if not already enabled)
# 3. Go to https://myaccount.google.com/apppasswords
# 4. Select "Mail" as the app
# 5. Select "Other" as the device (name it "OTax App")
# 6. Copy the 16-character password (it will look like: abcd efgh ijkl mnop)
# 7. Remove spaces and use it as SMTP_PASS (e.g., abcdefghijklmnop)
#
# DO NOT use your regular Gmail password - it won't work!

